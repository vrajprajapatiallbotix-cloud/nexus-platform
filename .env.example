# ============================================================
# NEXUS PLATFORM - ENVIRONMENT CONFIGURATION
# ============================================================

# --- APP ---
NODE_ENV=development
APP_NAME="Nexus Platform"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# --- DATABASE ---
DATABASE_URL="postgresql://nexus:nexus_password@localhost:5432/nexus_db?schema=public"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# --- REDIS ---
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
REDIS_DB=0

# --- AUTH ---
JWT_SECRET="your-super-secret-jwt-key-min-64-chars-long-change-in-production"
JWT_EXPIRY=15m
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-64-chars-change-in-production"
JWT_REFRESH_EXPIRY=7d
ENCRYPTION_KEY="32-chars-encryption-key-change-it"

# --- OAUTH ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# --- AI ---
OPENAI_API_KEY=""
OPENAI_ORG_ID=""
ANTHROPIC_API_KEY=""
DEEPGRAM_API_KEY=""
PINECONE_API_KEY=""
PINECONE_ENVIRONMENT=""
PINECONE_INDEX_NAME="nexus-knowledge"

# --- STRIPE ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- AWS ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="nexus-platform-files"
AWS_S3_ENDPOINT=""
AWS_CLOUDFRONT_URL=""

# --- EMAIL ---
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@nexusplatform.io"
POSTMARK_API_KEY=""
SENDGRID_API_KEY=""

# --- SMS ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# --- PUSH NOTIFICATIONS ---
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@nexusplatform.io"
FCM_SERVER_KEY=""

# --- KAFKA ---
KAFKA_BROKERS="localhost:9092"
KAFKA_GROUP_ID="nexus-consumer-group"
KAFKA_CLIENT_ID="nexus-platform"

# --- MONITORING ---
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_SENTRY_DSN=""
DATADOG_API_KEY=""
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# --- RATE LIMITING ---
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# --- FEATURE FLAGS ---
FEATURE_AI_ENABLED=true
FEATURE_VIDEO_MEETINGS=true
FEATURE_VOICE_AI=true
FEATURE_TRANSLATION=true
FEATURE_CRM=true
FEATURE_HR=true

# --- INTEGRATIONS ---
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
JIRA_CLIENT_ID=""
JIRA_CLIENT_SECRET=""
