// ============================================================
// NEXUS PLATFORM - COMPLETE PRISMA SCHEMA
// Enterprise Multi-Tenant SaaS Architecture
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex", "relationJoins", "omitApi"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  MEMBER
  VIEWER
  GUEST
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DELETED
}

enum OAuthProvider {
  GOOGLE
  GITHUB
  MICROSOFT
  SLACK
}

enum PlanType {
  FREE
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  PAUSED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
  GUEST
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum ProjectType {
  SCRUM
  KANBAN
  WATERFALL
  AGILE
  CUSTOM
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
  NONE
}

enum TaskType {
  TASK
  BUG
  STORY
  EPIC
  FEATURE
  IMPROVEMENT
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ChannelType {
  PUBLIC
  PRIVATE
  DIRECT
  GROUP
}

enum MessageType {
  TEXT
  FILE
  IMAGE
  VIDEO
  AUDIO
  SYSTEM
  AI
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMPLETED
  TASK_COMMENTED
  TASK_MENTIONED
  PROJECT_UPDATED
  DOCUMENT_SHARED
  MEETING_SCHEDULED
  MEETING_STARTED
  MESSAGE_RECEIVED
  MENTION
  WORKSPACE_INVITE
  BILLING_ALERT
  AI_INSIGHT
  AUTOMATION_TRIGGERED
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  SLACK
}

enum AutomationTrigger {
  TASK_CREATED
  TASK_STATUS_CHANGED
  TASK_ASSIGNED
  TASK_DUE_DATE
  PROJECT_STATUS_CHANGED
  FORM_SUBMITTED
  WEBHOOK
  SCHEDULE
  MANUAL
  AI_TRIGGERED
}

enum AutomationActionType {
  ASSIGN_TASK
  CHANGE_STATUS
  SEND_NOTIFICATION
  SEND_EMAIL
  CREATE_TASK
  MOVE_TASK
  ADD_TAG
  WEBHOOK_CALL
  AI_GENERATE
  SLACK_MESSAGE
}

enum CrmLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  NURTURING
}

enum CrmDealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  FREELANCE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  BEREAVEMENT
  UNPAID
  COMPENSATORY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEKEND
}

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FileCategory {
  DOCUMENT
  IMAGE
  VIDEO
  AUDIO
  ARCHIVE
  OTHER
}

enum AiSessionType {
  CHAT
  DOCUMENT_ASSIST
  TASK_ASSIST
  MEETING_SUMMARY
  TRANSLATION
  TRANSCRIPTION
  WORKFLOW_SUGGEST
  CODE_ASSIST
}

enum WebhookStatus {
  ACTIVE
  INACTIVE
  FAILED
}

enum IntegrationProvider {
  SLACK
  GITHUB
  GITLAB
  ZOOM
  GOOGLE_DRIVE
  DROPBOX
  JIRA
  TRELLO
  ZAPIER
  OUTLOOK
  TEAMS
  NOTION
}

enum TimeTrackingStatus {
  RUNNING
  PAUSED
  STOPPED
}

// ============================================================
// CORE USER & AUTH MODELS
// ============================================================

model User {
  id                    String            @id @default(cuid())
  email                 String            @unique
  emailVerified         Boolean           @default(false)
  emailVerifiedAt       DateTime?
  username              String?           @unique
  displayName           String
  firstName             String?
  lastName              String?
  avatarUrl             String?
  bio                   String?
  timezone              String            @default("UTC")
  locale                String            @default("en")
  theme                 String            @default("system")
  phone                 String?
  phoneVerified         Boolean           @default(false)
  passwordHash          String?
  twoFactorEnabled      Boolean           @default(false)
  twoFactorSecret       String?
  twoFactorBackupCodes  String[]
  role                  UserRole          @default(MEMBER)
  status                UserStatus        @default(PENDING_VERIFICATION)
  lastActiveAt          DateTime?
  lastLoginAt           DateTime?
  loginCount            Int               @default(0)
  onboardingCompleted   Boolean           @default(false)
  onboardingStep        Int               @default(0)
  preferences           Json              @default("{}")
  metadata              Json              @default("{}")
  deletedAt             DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relations
  accounts              OAuthAccount[]
  sessions              UserSession[]
  refreshTokens         RefreshToken[]
  magicLinks            MagicLink[]
  deviceSessions        DeviceSession[]
  organizationMembers   OrganizationMember[]
  workspaceMembers      WorkspaceMember[]
  teamMembers           TeamMember[]
  ownedProjects         Project[]         @relation("ProjectOwner")
  projectMembers        ProjectMember[]
  assignedTasks         Task[]            @relation("TaskAssignee")
  createdTasks          Task[]            @relation("TaskCreator")
  taskComments          TaskComment[]
  taskTimeEntries       TimeEntry[]
  documents             Document[]        @relation("DocumentAuthor")
  documentCollaborators DocumentCollaborator[]
  messages              Message[]
  channelMembers        ChannelMember[]
  notifications         Notification[]
  notificationPrefs     NotificationPreference[]
  aiSessions            AiSession[]
  crmContacts           CrmContact[]      @relation("ContactOwner")
  crmLeads              CrmLead[]         @relation("LeadOwner")
  crmActivities         CrmActivity[]     @relation("ActivityOwner")
  employeeProfile       Employee?
  automations           Automation[]
  webhooks              Webhook[]
  integrations          Integration[]
  auditLogs             AuditLog[]
  activityLogs          ActivityLog[]
  files                 File[]
  reactions             Reaction[]
  mentions              Mention[]
  watchedTasks          TaskWatcher[]
  meetingParticipants   MeetingParticipant[]

  @@index([email])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model OAuthAccount {
  id              String        @id @default(cuid())
  userId          String
  provider        OAuthProvider
  providerAccountId String
  accessToken     String?
  refreshToken    String?
  idToken         String?
  tokenType       String?
  scope           String?
  expiresAt       DateTime?
  rawProfile      Json          @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model UserSession {
  id            String    @id @default(cuid())
  userId        String
  token         String    @unique
  ipAddress     String?
  userAgent     String?
  deviceInfo    Json      @default("{}")
  lastActiveAt  DateTime  @default(now())
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("user_sessions")
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  token       String    @unique
  familyId    String
  used        Boolean   @default(false)
  revokedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([familyId])
  @@map("refresh_tokens")
}

model MagicLink {
  id          String    @id @default(cuid())
  userId      String?
  email       String
  token       String    @unique
  used        Boolean   @default(false)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([token])
  @@index([email])
  @@map("magic_links")
}

model DeviceSession {
  id            String    @id @default(cuid())
  userId        String
  deviceId      String
  deviceName    String?
  deviceType    String?
  browser       String?
  os            String?
  ipAddress     String?
  isTrusted     Boolean   @default(false)
  lastActiveAt  DateTime  @default(now())
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("device_sessions")
}

// ============================================================
// ORGANIZATION & WORKSPACE
// ============================================================

model Organization {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  logoUrl         String?
  domain          String?   @unique
  website         String?
  description     String?
  industry        String?
  size            String?
  country         String?
  timezone        String    @default("UTC")
  settings        Json      @default("{}")
  metadata        Json      @default("{}")
  isVerified      Boolean   @default(false)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  members         OrganizationMember[]
  workspaces      Workspace[]
  subscription    Subscription?
  invoices        Invoice[]
  plans           OrganizationPlan[]
  integrations    Integration[]
  auditLogs       AuditLog[]
  activityLogs    ActivityLog[]
  employees       Employee[]
  payrollRules    PayrollRule[]
  departments     Department[]
  customFields    CustomField[]
  tags            Tag[]
  labels          Label[]
  automations     Automation[]
  webhooks        Webhook[]

  @@index([slug])
  @@index([domain])
  @@index([deletedAt])
  @@map("organizations")
}

model OrganizationMember {
  id             String      @id @default(cuid())
  organizationId String
  userId         String
  role           UserRole    @default(MEMBER)
  title          String?
  department     String?
  isOwner        Boolean     @default(false)
  joinedAt       DateTime    @default(now())
  invitedBy      String?
  settings       Json        @default("{}")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model Department {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  description    String?
  headId         String?
  parentId       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children       Department[] @relation("DeptHierarchy")
  employees      Employee[]

  @@index([organizationId])
  @@map("departments")
}

model Workspace {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  logoUrl        String?
  color          String?
  isDefault      Boolean   @default(false)
  settings       Json      @default("{}")
  metadata       Json      @default("{}")
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        WorkspaceMember[]
  projects       Project[]
  teams          Team[]
  spaces         Space[]
  channels       Channel[]
  documents      Document[]
  files          File[]
  automations    Automation[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([deletedAt])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())
  invitedBy   String?
  settings    Json          @default("{}")

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

model Team {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  description String?
  color       String?
  iconUrl     String?
  settings    Json        @default("{}")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  projects    Project[]

  @@index([workspaceId])
  @@map("teams")
}

model TeamMember {
  id        String    @id @default(cuid())
  teamId    String
  userId    String
  role      String    @default("member")
  joinedAt  DateTime  @default(now())

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model Space {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  color       String?
  icon        String?
  isPrivate   Boolean   @default(false)
  settings    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects    Project[]
  documents   Document[]

  @@index([workspaceId])
  @@map("spaces")
}

model WorkspaceInvitation {
  id             String    @id @default(cuid())
  workspaceId    String
  email          String
  role           WorkspaceRole @default(MEMBER)
  token          String    @unique
  invitedBy      String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([workspaceId])
  @@index([email])
  @@index([token])
  @@map("workspace_invitations")
}

// ============================================================
// PROJECT MANAGEMENT
// ============================================================

model Project {
  id             String        @id @default(cuid())
  workspaceId    String
  spaceId        String?
  teamId         String?
  ownerId        String
  name           String
  description    String?
  key            String
  status         ProjectStatus @default(PLANNING)
  type           ProjectType   @default(KANBAN)
  priority       TaskPriority  @default(MEDIUM)
  color          String?
  icon           String?
  coverUrl       String?
  startDate      DateTime?
  endDate        DateTime?
  targetDate     DateTime?
  budget         Float?
  estimatedHours Float?
  trackedHours   Float         @default(0)
  progress       Float         @default(0)
  settings       Json          @default("{}")
  metadata       Json          @default("{}")
  isArchived     Boolean       @default(false)
  isTemplate     Boolean       @default(false)
  templateId     String?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  space          Space?        @relation(fields: [spaceId], references: [id])
  team           Team?         @relation(fields: [teamId], references: [id])
  owner          User          @relation("ProjectOwner", fields: [ownerId], references: [id])
  members        ProjectMember[]
  tasks          Task[]
  sprints        Sprint[]
  milestones     Milestone[]
  labels         ProjectLabel[]
  customFields   ProjectCustomField[]
  documents      Document[]
  meetings       Meeting[]
  timeEntries    TimeEntry[]
  activityLogs   ActivityLog[]
  automations    Automation[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@index([spaceId])
  @@index([ownerId])
  @@index([status])
  @@index([deletedAt])
  @@map("projects")
}

model ProjectMember {
  id        String    @id @default(cuid())
  projectId String
  userId    String
  role      String    @default("member")
  joinedAt  DateTime  @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model Sprint {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  goal        String?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(false)
  velocity    Float?
  capacity    Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([projectId])
  @@map("sprints")
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  color       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([projectId])
  @@map("milestones")
}

// ============================================================
// TASK MANAGEMENT
// ============================================================

model Task {
  id               String        @id @default(cuid())
  projectId        String?
  sprintId         String?
  milestoneId      String?
  parentId         String?
  assigneeId       String?
  creatorId        String
  title            String
  description      String?
  richDescription  Json?
  type             TaskType      @default(TASK)
  status           TaskStatus    @default(TODO)
  priority         TaskPriority  @default(MEDIUM)
  storyPoints      Int?
  orderIndex       Float         @default(0)
  startDate        DateTime?
  dueDate          DateTime?
  completedAt      DateTime?
  estimatedHours   Float?
  trackedHours     Float         @default(0)
  recurringRule    Json?
  customFields     Json          @default("{}")
  metadata         Json          @default("{}")
  isArchived       Boolean       @default(false)
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  project          Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sprint           Sprint?       @relation(fields: [sprintId], references: [id])
  milestone        Milestone?    @relation(fields: [milestoneId], references: [id])
  parent           Task?         @relation("TaskHierarchy", fields: [parentId], references: [id])
  subtasks         Task[]        @relation("TaskHierarchy")
  assignee         User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator          User          @relation("TaskCreator", fields: [creatorId], references: [id])
  comments         TaskComment[]
  labels           TaskLabel[]
  tags             TaskTag[]
  attachments      TaskAttachment[]
  timeEntries      TimeEntry[]
  watchers         TaskWatcher[]
  reactions        Reaction[]    @relation("TaskReactions")
  mentions         Mention[]
  dependencies     TaskDependency[] @relation("DependentTask")
  blockedBy        TaskDependency[] @relation("BlockingTask")
  checklists       TaskChecklist[]
  activityLogs     ActivityLog[]

  @@index([projectId])
  @@index([sprintId])
  @@index([assigneeId])
  @@index([creatorId])
  @@index([parentId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("tasks")
}

model TaskDependency {
  id            String    @id @default(cuid())
  dependentId   String
  blockingId    String
  type          String    @default("blocks")
  createdAt     DateTime  @default(now())

  dependent     Task      @relation("DependentTask", fields: [dependentId], references: [id], onDelete: Cascade)
  blocking      Task      @relation("BlockingTask", fields: [blockingId], references: [id], onDelete: Cascade)

  @@unique([dependentId, blockingId])
  @@index([dependentId])
  @@index([blockingId])
  @@map("task_dependencies")
}

model TaskChecklist {
  id          String              @id @default(cuid())
  taskId      String
  title       String
  orderIndex  Float               @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  task        Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items       TaskChecklistItem[]

  @@index([taskId])
  @@map("task_checklists")
}

model TaskChecklistItem {
  id          String        @id @default(cuid())
  checklistId String
  content     String
  isChecked   Boolean       @default(false)
  checkedAt   DateTime?
  checkedBy   String?
  orderIndex  Float         @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  checklist   TaskChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
  @@map("task_checklist_items")
}

model TaskComment {
  id          String    @id @default(cuid())
  taskId      String
  authorId    String
  parentId    String?
  content     String
  richContent Json?
  isEdited    Boolean   @default(false)
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id])
  parent      TaskComment? @relation("CommentThread", fields: [parentId], references: [id])
  replies     TaskComment[] @relation("CommentThread")
  reactions   Reaction[]  @relation("CommentReactions")
  mentions    Mention[]
  attachments TaskAttachment[]

  @@index([taskId])
  @@index([authorId])
  @@index([parentId])
  @@map("task_comments")
}

model TaskAttachment {
  id          String    @id @default(cuid())
  taskId      String
  commentId   String?
  fileId      String
  uploadedBy  String
  createdAt   DateTime  @default(now())

  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment     TaskComment? @relation(fields: [commentId], references: [id])
  file        File      @relation(fields: [fileId], references: [id])

  @@index([taskId])
  @@map("task_attachments")
}

model TaskWatcher {
  id      String  @id @default(cuid())
  taskId  String
  userId  String

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("task_watchers")
}

model TimeEntry {
  id          String              @id @default(cuid())
  taskId      String?
  projectId   String?
  userId      String
  description String?
  startTime   DateTime
  endTime     DateTime?
  duration    Int?                // seconds
  status      TimeTrackingStatus  @default(RUNNING)
  isBillable  Boolean             @default(false)
  hourlyRate  Float?
  metadata    Json                @default("{}")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  task        Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project     Project?            @relation(fields: [projectId], references: [id])
  user        User                @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([projectId])
  @@index([userId])
  @@index([startTime])
  @@map("time_entries")
}

// ============================================================
// LABELS, TAGS, CUSTOM FIELDS
// ============================================================

model Label {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  color          String
  description    String?
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          TaskLabel[]
  projectLabels  ProjectLabel[]

  @@index([organizationId])
  @@map("labels")
}

model TaskLabel {
  taskId    String
  labelId   String

  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label     Label   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_labels")
}

model ProjectLabel {
  projectId String
  labelId   String

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     Label   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([projectId, labelId])
  @@map("project_labels")
}

model Tag {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  color          String?
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          TaskTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("tags")
}

model TaskTag {
  taskId  String
  tagId   String

  task    Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag     Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}

model CustomField {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  type           String    // text, number, date, select, multiselect, checkbox, url, email, phone
  options        Json?     // for select/multiselect
  isRequired     Boolean   @default(false)
  defaultValue   Json?
  settings       Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectFields  ProjectCustomField[]

  @@index([organizationId])
  @@map("custom_fields")
}

model ProjectCustomField {
  projectId     String
  customFieldId String
  orderIndex    Float   @default(0)

  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@id([projectId, customFieldId])
  @@map("project_custom_fields")
}

// ============================================================
// DOCUMENTS & KNOWLEDGE BASE
// ============================================================

model Document {
  id           String         @id @default(cuid())
  workspaceId  String
  spaceId      String?
  projectId    String?
  authorId     String
  parentId     String?
  title        String
  content      Json?
  plainText    String?
  status       DocumentStatus @default(DRAFT)
  isPublished  Boolean        @default(false)
  publishedAt  DateTime?
  coverUrl     String?
  icon         String?
  orderIndex   Float          @default(0)
  wordCount    Int            @default(0)
  readTime     Int            @default(0)
  viewCount    Int            @default(0)
  settings     Json           @default("{}")
  metadata     Json           @default("{}")
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  space        Space?         @relation(fields: [spaceId], references: [id])
  project      Project?       @relation(fields: [projectId], references: [id])
  author       User           @relation("DocumentAuthor", fields: [authorId], references: [id])
  parent       Document?      @relation("DocHierarchy", fields: [parentId], references: [id])
  children     Document[]     @relation("DocHierarchy")
  collaborators DocumentCollaborator[]
  versions     DocumentVersion[]
  comments     DocumentComment[]
  tags         DocumentTag[]

  @@index([workspaceId])
  @@index([authorId])
  @@index([parentId])
  @@index([projectId])
  @@index([deletedAt])
  @@map("documents")
}

model DocumentCollaborator {
  documentId String
  userId     String
  role       String    @default("editor")
  addedAt    DateTime  @default(now())

  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([documentId, userId])
  @@map("document_collaborators")
}

model DocumentVersion {
  id          String    @id @default(cuid())
  documentId  String
  authorId    String
  content     Json
  title       String
  version     Int
  changelog   String?
  createdAt   DateTime  @default(now())

  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_versions")
}

model DocumentComment {
  id          String    @id @default(cuid())
  documentId  String
  authorId    String
  content     String
  position    Json?
  isResolved  Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_comments")
}

model DocumentTag {
  documentId String
  tag        String

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([documentId, tag])
  @@map("document_tags")
}

// ============================================================
// CHAT & COMMUNICATION
// ============================================================

model Channel {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  description String?
  type        ChannelType @default(PUBLIC)
  topic       String?
  avatarUrl   String?
  isArchived  Boolean     @default(false)
  isDefault   Boolean     @default(false)
  settings    Json        @default("{}")
  createdBy   String
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     ChannelMember[]
  messages    Message[]
  pinnedMessages PinnedMessage[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([type])
  @@map("channels")
}

model ChannelMember {
  channelId         String
  userId            String
  role              String    @default("member")
  isAdmin           Boolean   @default(false)
  isMuted           Boolean   @default(false)
  lastReadAt        DateTime?
  notificationsMode String    @default("all")
  joinedAt          DateTime  @default(now())

  channel           Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([channelId])
  @@index([userId])
  @@map("channel_members")
}

model Message {
  id          String      @id @default(cuid())
  channelId   String
  authorId    String
  parentId    String?
  content     String?
  richContent Json?
  type        MessageType @default(TEXT)
  isEdited    Boolean     @default(false)
  editedAt    DateTime?
  isPinned    Boolean     @default(false)
  metadata    Json        @default("{}")
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  channel     Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorId], references: [id])
  parent      Message?    @relation("MessageThread", fields: [parentId], references: [id])
  replies     Message[]   @relation("MessageThread")
  reactions   Reaction[]  @relation("MessageReactions")
  mentions    Mention[]
  attachments MessageAttachment[]
  pinned      PinnedMessage?

  @@index([channelId])
  @@index([authorId])
  @@index([parentId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("messages")
}

model MessageAttachment {
  id          String    @id @default(cuid())
  messageId   String
  fileId      String
  createdAt   DateTime  @default(now())

  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file        File      @relation(fields: [fileId], references: [id])

  @@index([messageId])
  @@map("message_attachments")
}

model PinnedMessage {
  channelId   String
  messageId   String   @unique
  pinnedBy    String
  pinnedAt    DateTime @default(now())

  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([channelId, messageId])
  @@map("pinned_messages")
}

model Reaction {
  id          String    @id @default(cuid())
  userId      String
  emoji       String
  taskId      String?
  commentId   String?
  messageId   String?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task        Task?     @relation("TaskReactions", fields: [taskId], references: [id], onDelete: Cascade)
  comment     TaskComment? @relation("CommentReactions", fields: [commentId], references: [id], onDelete: Cascade)
  message     Message?  @relation("MessageReactions", fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, emoji, taskId])
  @@unique([userId, emoji, commentId])
  @@unique([userId, emoji, messageId])
  @@index([userId])
  @@index([taskId])
  @@index([messageId])
  @@map("reactions")
}

model Mention {
  id          String    @id @default(cuid())
  mentionedId String
  mentionedBy String
  taskId      String?
  commentId   String?
  messageId   String?
  documentId  String?
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  mentionedUser User    @relation(fields: [mentionedId], references: [id], onDelete: Cascade)
  task          Task?   @relation(fields: [taskId], references: [id])
  comment       TaskComment? @relation(fields: [commentId], references: [id])
  message       Message? @relation(fields: [messageId], references: [id])

  @@index([mentionedId])
  @@index([mentionedBy])
  @@map("mentions")
}

// ============================================================
// VIDEO MEETINGS
// ============================================================

model Meeting {
  id             String          @id @default(cuid())
  projectId      String?
  channelId      String?
  organizerId    String
  title          String
  description    String?
  status         MeetingStatus   @default(SCHEDULED)
  startTime      DateTime
  endTime        DateTime?
  duration       Int?            // minutes
  meetingUrl     String?
  recordingUrl   String?
  transcriptId   String?
  summaryId      String?
  password       String?
  isRecurring    Boolean         @default(false)
  recurringRule  Json?
  settings       Json            @default("{}")
  metadata       Json            @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  project        Project?        @relation(fields: [projectId], references: [id])
  participants   MeetingParticipant[]
  transcription  AiTranscription?
  summary        AiSummary?
  notes          MeetingNote[]

  @@index([projectId])
  @@index([organizerId])
  @@index([startTime])
  @@index([status])
  @@map("meetings")
}

model MeetingParticipant {
  meetingId   String
  userId      String
  role        String    @default("participant")
  joinedAt    DateTime?
  leftAt      DateTime?
  duration    Int?

  meeting     Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@map("meeting_participants")
}

model MeetingNote {
  id        String    @id @default(cuid())
  meetingId String
  authorId  String
  content   Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_notes")
}

// ============================================================
// AI MODULE
// ============================================================

model AiSession {
  id          String          @id @default(cuid())
  userId      String
  type        AiSessionType
  title       String?
  context     Json            @default("{}")
  metadata    Json            @default("{}")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    AiMessage[]

  @@index([userId])
  @@index([type])
  @@map("ai_sessions")
}

model AiMessage {
  id          String    @id @default(cuid())
  sessionId   String
  role        String    // user | assistant | system
  content     String
  model       String?
  tokens      Int?
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())

  session     AiSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("ai_messages")
}

model AiTranscription {
  id          String    @id @default(cuid())
  meetingId   String?   @unique
  fileId      String?
  language    String    @default("en")
  rawText     String
  segments    Json      // speaker diarization segments
  words       Json?     // word-level timestamps
  confidence  Float?
  duration    Float?    // seconds
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  meeting     Meeting?  @relation(fields: [meetingId], references: [id])

  @@index([meetingId])
  @@map("ai_transcriptions")
}

model AiSummary {
  id          String    @id @default(cuid())
  meetingId   String?   @unique
  documentId  String?
  projectId   String?
  type        String    // meeting | document | project | sprint
  content     String
  keyPoints   Json?
  actionItems Json?
  decisions   Json?
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())

  meeting     Meeting?  @relation(fields: [meetingId], references: [id])

  @@index([meetingId])
  @@map("ai_summaries")
}

model AiTranslation {
  id              String    @id @default(cuid())
  sourceText      String
  translatedText  String
  sourceLanguage  String
  targetLanguage  String
  provider        String    @default("openai")
  confidence      Float?
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now())

  @@map("ai_translations")
}

model KnowledgeBase {
  id          String    @id @default(cuid())
  workspaceId String
  sourceType  String    // document | task | meeting | custom
  sourceId    String
  content     String
  embedding   Bytes?
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@index([sourceType, sourceId])
  @@map("knowledge_base")
}

// ============================================================
// CRM MODULE
// ============================================================

model CrmPipeline {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isDefault      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  stages         CrmPipelineStage[]
  deals          CrmDeal[]

  @@index([organizationId])
  @@map("crm_pipelines")
}

model CrmPipelineStage {
  id          String      @id @default(cuid())
  pipelineId  String
  name        String
  stage       CrmDealStage
  probability Float       @default(0)
  color       String?
  orderIndex  Float       @default(0)
  isWon       Boolean     @default(false)
  isLost      Boolean     @default(false)

  pipeline    CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals       CrmDeal[]

  @@index([pipelineId])
  @@map("crm_pipeline_stages")
}

model CrmContact {
  id             String      @id @default(cuid())
  organizationId String
  ownerId        String
  companyId      String?
  firstName      String
  lastName       String
  email          String?
  phone          String?
  title          String?
  linkedin       String?
  twitter        String?
  avatarUrl      String?
  tags           String[]
  customFields   Json        @default("{}")
  metadata       Json        @default("{}")
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  owner          User        @relation("ContactOwner", fields: [ownerId], references: [id])
  company        CrmCompany? @relation(fields: [companyId], references: [id])
  leads          CrmLead[]
  deals          CrmContactDeal[]
  activities     CrmActivity[]

  @@index([organizationId])
  @@index([ownerId])
  @@index([email])
  @@map("crm_contacts")
}

model CrmCompany {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  domain         String?
  industry       String?
  size           String?
  revenue        Float?
  country        String?
  website        String?
  logoUrl        String?
  description    String?
  tags           String[]
  customFields   Json        @default("{}")
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  contacts       CrmContact[]
  deals          CrmDeal[]
  leads          CrmLead[]

  @@index([organizationId])
  @@map("crm_companies")
}

model CrmLead {
  id             String        @id @default(cuid())
  organizationId String
  ownerId        String
  contactId      String?
  companyId      String?
  title          String
  description    String?
  status         CrmLeadStatus @default(NEW)
  source         String?
  value          Float?
  probability    Float?
  tags           String[]
  customFields   Json          @default("{}")
  convertedAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  owner          User          @relation("LeadOwner", fields: [ownerId], references: [id])
  contact        CrmContact?   @relation(fields: [contactId], references: [id])
  company        CrmCompany?   @relation(fields: [companyId], references: [id])
  activities     CrmActivity[]

  @@index([organizationId])
  @@index([ownerId])
  @@index([status])
  @@map("crm_leads")
}

model CrmDeal {
  id          String            @id @default(cuid())
  pipelineId  String
  stageId     String
  ownerId     String
  companyId   String?
  title       String
  value       Float?
  currency    String            @default("USD")
  probability Float?
  closeDate   DateTime?
  wonAt       DateTime?
  lostAt      DateTime?
  lostReason  String?
  tags        String[]
  customFields Json             @default("{}")
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  pipeline    CrmPipeline       @relation(fields: [pipelineId], references: [id])
  stage       CrmPipelineStage  @relation(fields: [stageId], references: [id])
  company     CrmCompany?       @relation(fields: [companyId], references: [id])
  contacts    CrmContactDeal[]
  activities  CrmActivity[]

  @@index([pipelineId])
  @@index([stageId])
  @@index([ownerId])
  @@map("crm_deals")
}

model CrmContactDeal {
  contactId String
  dealId    String
  role      String?

  contact   CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal      CrmDeal    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@id([contactId, dealId])
  @@map("crm_contact_deals")
}

model CrmActivity {
  id          String    @id @default(cuid())
  ownerId     String
  contactId   String?
  leadId      String?
  dealId      String?
  type        String    // call | email | meeting | note | task | demo
  title       String
  content     String?
  dueDate     DateTime?
  completedAt DateTime?
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner       User        @relation("ActivityOwner", fields: [ownerId], references: [id])
  contact     CrmContact? @relation(fields: [contactId], references: [id])
  lead        CrmLead?    @relation(fields: [leadId], references: [id])
  deal        CrmDeal?    @relation(fields: [dealId], references: [id])

  @@index([ownerId])
  @@index([contactId])
  @@index([leadId])
  @@index([dealId])
  @@map("crm_activities")
}

// ============================================================
// HR MODULE
// ============================================================

model Employee {
  id               String          @id @default(cuid())
  organizationId   String
  userId           String          @unique
  departmentId     String?
  managerId        String?
  employeeCode     String?
  jobTitle         String?
  employmentType   EmploymentType  @default(FULL_TIME)
  status           EmployeeStatus  @default(ACTIVE)
  startDate        DateTime
  endDate          DateTime?
  salary           Float?
  currency         String          @default("USD")
  bankAccount      Json?
  address          Json?
  emergencyContact Json?
  documents        Json            @default("[]")
  metadata         Json            @default("{}")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id])
  department       Department?     @relation(fields: [departmentId], references: [id])
  attendance       Attendance[]
  leaveRequests    LeaveRequest[]
  leaveBalance     LeaveBalance[]
  performanceReviews PerformanceReview[] @relation("ReviewedEmployee")
  reviewsGiven     PerformanceReview[]  @relation("Reviewer")

  @@index([organizationId])
  @@index([departmentId])
  @@index([status])
  @@map("employees")
}

model Attendance {
  id           String           @id @default(cuid())
  employeeId   String
  date         DateTime         @db.Date
  status       AttendanceStatus @default(PRESENT)
  checkIn      DateTime?
  checkOut     DateTime?
  duration     Int?             // minutes
  overtime     Int?             // minutes
  location     Json?
  notes        String?
  approvedBy   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@map("attendance")
}

model LeaveRequest {
  id          String      @id @default(cuid())
  employeeId  String
  type        LeaveType
  status      LeaveStatus @default(PENDING)
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  days        Float
  reason      String?
  approvedBy  String?
  approvedAt  DateTime?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@map("leave_requests")
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  type        LeaveType
  year        Int
  allocated   Float
  used        Float     @default(0)
  pending     Float     @default(0)
  remaining   Float

  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, type, year])
  @@index([employeeId])
  @@map("leave_balances")
}

model PerformanceReview {
  id              String    @id @default(cuid())
  employeeId      String
  reviewerId      String
  period          String    // e.g., "Q1 2024"
  rating          Float?
  strengths       String?
  improvements    String?
  goals           Json?
  comments        String?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  employee        Employee  @relation("ReviewedEmployee", fields: [employeeId], references: [id])
  reviewer        Employee  @relation("Reviewer", fields: [reviewerId], references: [id])

  @@index([employeeId])
  @@map("performance_reviews")
}

model PayrollRule {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  type           String    // deduction | bonus | allowance | tax
  calculationType String   // fixed | percentage
  value          Float
  conditions     Json?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("payroll_rules")
}

// ============================================================
// AUTOMATION ENGINE
// ============================================================

model Automation {
  id             String    @id @default(cuid())
  organizationId String?
  workspaceId    String?
  projectId      String?
  creatorId      String
  name           String
  description    String?
  trigger        AutomationTrigger
  triggerConfig  Json      @default("{}")
  conditions     Json      @default("[]")
  actions        Json      @default("[]")
  isActive       Boolean   @default(true)
  runCount       Int       @default(0)
  lastRunAt      DateTime?
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id])
  workspace      Workspace?    @relation(fields: [workspaceId], references: [id])
  project        Project?      @relation(fields: [projectId], references: [id])
  creator        User          @relation(fields: [creatorId], references: [id])
  runs           AutomationRun[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([creatorId])
  @@index([isActive])
  @@map("automations")
}

model AutomationRun {
  id           String    @id @default(cuid())
  automationId String
  status       String    // pending | running | success | failed | skipped
  triggerData  Json      @default("{}")
  result       Json?
  error        String?
  duration     Int?      // ms
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([status])
  @@map("automation_runs")
}

// ============================================================
// FILE STORAGE
// ============================================================

model File {
  id          String      @id @default(cuid())
  uploaderId  String
  workspaceId String?
  name        String
  originalName String
  mimeType    String
  size        Int         // bytes
  url         String
  s3Key       String
  s3Bucket    String
  category    FileCategory @default(OTHER)
  width       Int?
  height      Int?
  duration    Float?
  thumbnailUrl String?
  isPublic    Boolean     @default(false)
  checksum    String?
  metadata    Json        @default("{}")
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  uploader         User              @relation(fields: [uploaderId], references: [id])
  workspace        Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  taskAttachments  TaskAttachment[]
  messageAttachments MessageAttachment[]

  @@index([uploaderId])
  @@index([workspaceId])
  @@index([category])
  @@index([deletedAt])
  @@map("files")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id          String              @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  body        String?
  data        Json                @default("{}")
  channel     NotificationChannel @default(IN_APP)
  isRead      Boolean             @default(false)
  readAt      DateTime?
  sentAt      DateTime?
  failedAt    DateTime?
  error       String?
  deletedAt   DateTime?
  createdAt   DateTime            @default(now())

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id          String              @id @default(cuid())
  userId      String
  type        NotificationType
  channel     NotificationChannel
  isEnabled   Boolean             @default(true)
  updatedAt   DateTime            @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])
  @@index([userId])
  @@map("notification_preferences")
}

// ============================================================
// BILLING & SUBSCRIPTIONS
// ============================================================

model Plan {
  id                String          @id @default(cuid())
  name              String
  type              PlanType        @unique
  description       String?
  price             Float
  yearlyPrice       Float?
  currency          String          @default("USD")
  trialDays         Int             @default(14)
  maxUsers          Int?
  maxProjects       Int?
  maxStorage        Int?            // GB
  maxAiCredits      Int?
  features          Json            @default("[]")
  stripeProductId   String?
  stripePriceId     String?
  stripeYearlyPriceId String?
  isActive          Boolean         @default(true)
  metadata          Json            @default("{}")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  subscriptions     Subscription[]
  organizationPlans OrganizationPlan[]

  @@map("plans")
}

model OrganizationPlan {
  id             String    @id @default(cuid())
  organizationId String
  planId         String
  addedAt        DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           Plan         @relation(fields: [planId], references: [id])

  @@unique([organizationId, planId])
  @@map("organization_plans")
}

model Subscription {
  id                  String              @id @default(cuid())
  organizationId      String              @unique
  planId              String
  status              SubscriptionStatus  @default(TRIALING)
  interval            BillingInterval     @default(MONTHLY)
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  trialStart          DateTime?
  trialEnd            DateTime?
  cancelAt            DateTime?
  canceledAt          DateTime?
  stripeCustomerId    String?
  stripeSubscriptionId String?
  stripePriceId       String?
  metadata            Json                @default("{}")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                Plan                @relation(fields: [planId], references: [id])
  usageRecords        UsageRecord[]

  @@index([organizationId])
  @@index([status])
  @@map("subscriptions")
}

model Invoice {
  id             String    @id @default(cuid())
  organizationId String
  amount         Float
  currency       String    @default("USD")
  status         String    // draft | open | paid | void | uncollectible
  dueDate        DateTime?
  paidAt         DateTime?
  stripeInvoiceId String?
  invoiceUrl     String?
  lineItems      Json      @default("[]")
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@map("invoices")
}

model UsageRecord {
  id             String    @id @default(cuid())
  subscriptionId String
  feature        String    // ai_credits | storage | api_calls | users
  quantity       Float
  period         String    // YYYY-MM
  recordedAt     DateTime  @default(now())

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([feature])
  @@index([period])
  @@map("usage_records")
}

// ============================================================
// INTEGRATIONS & WEBHOOKS
// ============================================================

model Integration {
  id             String              @id @default(cuid())
  organizationId String?
  userId         String
  provider       IntegrationProvider
  accessToken    String?
  refreshToken   String?
  expiresAt      DateTime?
  scope          String?
  config         Json                @default("{}")
  isActive       Boolean             @default(true)
  lastSyncAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization?       @relation(fields: [organizationId], references: [id])
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId])
  @@index([userId])
  @@map("integrations")
}

model Webhook {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String
  name           String
  url            String
  secret         String
  events         String[]
  status         WebhookStatus @default(ACTIVE)
  lastTriggeredAt DateTime?
  successCount   Int           @default(0)
  failureCount   Int           @default(0)
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries     WebhookDelivery[]

  @@index([organizationId])
  @@index([userId])
  @@map("webhooks")
}

model WebhookDelivery {
  id          String    @id @default(cuid())
  webhookId   String
  event       String
  payload     Json
  status      Int?      // HTTP status
  response    String?
  error       String?
  duration    Int?      // ms
  deliveredAt DateTime  @default(now())

  webhook     Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([event])
  @@map("webhook_deliveries")
}

// ============================================================
// AUDIT & ACTIVITY LOGS
// ============================================================

model AuditLog {
  id             String    @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  resourceType   String
  resourceId     String?
  oldValue       Json?
  newValue       Json?
  ipAddress      String?
  userAgent      String?
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ActivityLog {
  id             String    @id @default(cuid())
  organizationId String?
  projectId      String?
  taskId         String?
  userId         String
  action         String
  entityType     String
  entityId       String
  data           Json      @default("{}")
  createdAt      DateTime  @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id])
  project        Project?      @relation(fields: [projectId], references: [id])
  task           Task?         @relation(fields: [taskId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([projectId])
  @@index([taskId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ============================================================
// FEATURE FLAGS
// ============================================================

model FeatureFlag {
  id             String    @id @default(cuid())
  key            String    @unique
  name           String
  description    String?
  isEnabled      Boolean   @default(false)
  rules          Json      @default("[]")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("feature_flags")
}

// ============================================================
// API KEYS
// ============================================================

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  createdBy      String
  name           String
  keyHash        String    @unique
  keyPrefix      String
  scopes         String[]
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  ipWhitelist    String[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([keyHash])
  @@map("api_keys")
}
