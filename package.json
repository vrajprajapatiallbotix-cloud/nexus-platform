{
  "name": "nexus-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise AI-Powered Productivity & Collaboration Platform",
  "engines": {
    "node": "20.x",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "db:studio": "cd packages/database && pnpm prisma studio",
    "docker:dev": "docker-compose -f infrastructure/docker/docker-compose.dev.yml up -d",
    "docker:prod": "docker-compose -f infrastructure/docker/docker-compose.prod.yml up -d",
    "docker:down": "docker-compose -f infrastructure/docker/docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@turbo/gen": "^1.13.0",
    "prettier": "^3.3.0",
    "rimraf": "^5.0.0",
    "turbo": "^2.1.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@9.1.0"
}
